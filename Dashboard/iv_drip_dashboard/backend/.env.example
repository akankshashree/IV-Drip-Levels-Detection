# Gmail SMTP Configuration for IV Fluid Monitoring System
# Replace PROJECT_GMAIL_ADDRESS with your sender Gmail account (e.g. iv.monitoring.alert@gmail.com)
# Replace GOOGLE_APP_PASSWORD with the 16-character App Password generated in Google Account settings
# Replace MY_RECEIVER_EMAIL with your personal receiver Gmail address

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=PROJECT_GMAIL_ADDRESS
SMTP_PASSWORD=GOOGLE_APP_PASSWORD
ALERT_EMAIL_FROM=PROJECT_GMAIL_ADDRESS
ALERT_EMAIL_TO=MY_RECEIVER_EMAIL
