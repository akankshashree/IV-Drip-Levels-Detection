import 'dart:async';
// ignore: avoid_web_libraries_in_flutter
import 'dart:html' as html;
import 'package:flutter/material.dart';
import '../auth_service.dart';
import 'login_page.dart';

class NurseDashboard extends StatefulWidget {
  final String token;
  final Map<String, dynamic> user;

  const NurseDashboard({
    super.key,
    required this.token,
    required this.user,
  });

  @override
  State<NurseDashboard> createState() => _NurseDashboardState();
}

class _NurseDashboardState extends State<NurseDashboard> {
  List<dynamic> patients = [];
  final Map<String, Map<String, dynamic>> monitoringData = {};
  List<dynamic> alerts = [];

  bool loading = true;
  bool refreshing = false;
  String? errorMessage;
  Timer? refreshTimer;

  // Default Raspberry Pi streaming address (user-configurable in UI)
  String piStreamHost = 'raspberrypi.local:8080';
  final Map<String, String> selectedCameraSource = {}; // patientId -> 'pi' or 'webcam'

  @override
  void initState() {
    super.initState();
    loadDashboardData();

    refreshTimer = Timer.periodic(
      const Duration(seconds: 5),
      (_) => refreshMonitoring(),
    );
  }

  @override
  void dispose() {
    refreshTimer?.cancel();
    super.dispose();
  }

  Future<void> loadDashboardData() async {
    setState(() {
      loading = true;
      errorMessage = null;
    });

    try {
      final results = await Future.wait([
        AuthService.getPatients(widget.token),
        AuthService.getAlerts(widget.token),
      ]);

      if (!mounted) return;

      setState(() {
        patients = results[0];
        alerts = results[1];
        loading = false;
      });

      await refreshMonitoring();
    } catch (e) {
      if (!mounted) return;

      setState(() {
        errorMessage = e.toString().replaceFirst('Exception: ', '');
        loading = false;
      });
    }
  }

  Future<void> loadPatients() async {
    await loadDashboardData();
  }

  Future<void> loadAlerts() async {
    try {
      final fetchedAlerts = await AuthService.getAlerts(widget.token);
      if (!mounted) return;
      setState(() {
        alerts = fetchedAlerts;
      });
    } catch (_) {}
  }

  Future<void> acknowledgeAlert(int alertId) async {
    try {
      await AuthService.acknowledgeAlert(widget.token, alertId);
      await loadAlerts();
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Alert acknowledged.'),
          backgroundColor: Colors.teal,
        ),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Could not acknowledge alert: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> resolveAlert(int alertId) async {
    try {
      await AuthService.resolveAlert(widget.token, alertId);
      await loadAlerts();
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(
          content: Text('Alert resolved. Container replaced.'),
          backgroundColor: Colors.green,
        ),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Could not resolve alert: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> triggerTestAlert(String patientId) async {
    try {
      await AuthService.sendTestAlert(widget.token, patientId);
      await loadAlerts();
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Test empty-fluid alert sent for $patientId.'),
          backgroundColor: Colors.teal,
        ),
      );
    } catch (e) {
      if (!mounted) return;
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(
          content: Text('Error triggering test alert: $e'),
          backgroundColor: Colors.red,
        ),
      );
    }
  }

  Future<void> refreshMonitoring() async {
    if (refreshing || patients.isEmpty) return;

    refreshing = true;

    try {
      final results = await Future.wait(
        patients.map((patient) async {
          final patientId = patient['patient_id'].toString();

          try {
            final result = await AuthService.getPatientMonitoring(
              widget.token,
              patientId,
            );

            return MapEntry(patientId, result);
          } catch (_) {
            return null;
          }
        }),
      );

      final fetchedAlerts = await AuthService.getAlerts(widget.token);

      if (!mounted) return;

      setState(() {
        for (final result in results) {
          if (result != null) {
            monitoringData[result.key] = result.value;
          }
        }
        alerts = fetchedAlerts;
      });
    } catch (_) {
    } finally {
      refreshing = false;
    }
  }

  void showLiveCamera(String patientName, String patientId) {
    final hostController = TextEditingController(text: piStreamHost);
    String activeSource = selectedCameraSource[patientId] ?? 'pi';
    bool showSettings = false;

    showDialog(
      context: context,
      builder: (dialogContext) {
        return StatefulBuilder(
          builder: (context, setDialogState) {
            final monitoring = monitoringData[patientId];
            final latestReading = monitoring?['latest_reading'];
            final deviceStatus = monitoring?['device_status']?.toString() ?? 'offline';
            final level = latestReading?['level_label']?.toString();
            final confidence = latestReading?['confidence'];
            final isEmpty = level == 'Empty';
            final currentStreamUrl = 'http://$piStreamHost/video_feed';

            return Dialog(
              child: ConstrainedBox(
                constraints: const BoxConstraints(maxWidth: 820),
                child: SingleChildScrollView(
                  padding: const EdgeInsets.all(22),
                  child: Column(
                    mainAxisSize: MainAxisSize.min,
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      // Header
                      Row(
                        children: [
                          Icon(
                            activeSource == 'pi' ? Icons.videocam : Icons.laptop_chromebook,
                            color: const Color(0xFF0F766E),
                            size: 26,
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Text(
                                  'Live Monitoring — $patientName',
                                  style: const TextStyle(
                                    fontSize: 19,
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                Text(
                                  'Patient ID: $patientId | Source: ${activeSource == 'pi' ? 'Raspberry Pi Camera (Primary)' : 'Laptop Webcam (Backup)'}',
                                  style: const TextStyle(color: Colors.black54, fontSize: 13),
                                ),
                              ],
                            ),
                          ),
                          IconButton(
                            onPressed: () => Navigator.pop(dialogContext),
                            icon: const Icon(Icons.close),
                            tooltip: 'Close',
                          ),
                        ],
                      ),
                      const SizedBox(height: 16),

                      // Camera Source Selector (Toggle Buttons)
                      Container(
                        padding: const EdgeInsets.all(4),
                        decoration: BoxDecoration(
                          color: Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(10),
                          border: Border.all(color: Colors.grey.shade300),
                        ),
                        child: Row(
                          children: [
                            Expanded(
                              child: InkWell(
                                onTap: () {
                                  setDialogState(() {
                                    activeSource = 'pi';
                                    selectedCameraSource[patientId] = 'pi';
                                  });
                                  setState(() {});
                                },
                                borderRadius: BorderRadius.circular(8),
                                child: Container(
                                  padding: const EdgeInsets.symmetric(vertical: 10),
                                  decoration: BoxDecoration(
                                    color: activeSource == 'pi' ? const Color(0xFF0F766E) : Colors.transparent,
                                    borderRadius: BorderRadius.circular(8),
                                  ),
                                  alignment: Alignment.center,
                                  child: Row(
                                    mainAxisAlignment: MainAxisAlignment.center,
                                    children: [
                                      Icon(
                                        Icons.camera,
                                        size: 18,
                                        color: activeSource == 'pi' ? Colors.white : Colors.black87,
                                      ),
                                      const SizedBox(width: 8),
                                      Text(
                                        'Raspberry Pi Camera (Primary)',
                                        style: TextStyle(
                                          fontWeight: FontWeight.w600,
                                          fontSize: 13,
                                          color: activeSource == 'pi' ? Colors.white : Colors.black87,
                                        ),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            ),
                            const SizedBox(width: 6),
                            Expanded(
                              child: InkWell(
                                onTap: () {
                                  setDialogState(() {
                                    activeSource = 'webcam';
                                    selectedCameraSource[patientId] = 'webcam';
                                  });
                                  setState(() {});
                                },
                                borderRadius: BorderRadius.circular(8),
                                child: Container(
                                  padding: const EdgeInsets.symmetric(vertical: 10),
                                  decoration: BoxDecoration(
                                    color: activeSource == 'webcam' ? const Color(0xFF0F766E) : Colors.transparent,
                                    borderRadius: BorderRadius.circular(8),
                                  ),
                                  alignment: Alignment.center,
                                  child: Row(
                                    mainAxisAlignment: MainAxisAlignment.center,
                                    children: [
                                      Icon(
                                        Icons.laptop_chromebook,
                                        size: 18,
                                        color: activeSource == 'webcam' ? Colors.white : Colors.black87,
                                      ),
                                      const SizedBox(width: 8),
                                      Text(
                                        'Laptop Webcam (Backup)',
                                        style: TextStyle(
                                          fontWeight: FontWeight.w600,
                                          fontSize: 13,
                                          color: activeSource == 'webcam' ? Colors.white : Colors.black87,
                                        ),
                                      ),
                                    ],
                                  ),
                                ),
                              ),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(height: 16),

                      // Camera Feed View Area
                      if (activeSource == 'pi') ...[
                        AspectRatio(
                          aspectRatio: 16 / 9,
                          child: Container(
                            decoration: BoxDecoration(
                              color: Colors.black,
                              borderRadius: BorderRadius.circular(8),
                            ),
                            clipBehavior: Clip.antiAlias,
                            alignment: Alignment.center,
                            child: Image.network(
                              currentStreamUrl,
                              fit: BoxFit.contain,
                              width: double.infinity,
                              height: double.infinity,
                              errorBuilder: (context, error, stackTrace) {
                                return Padding(
                                  padding: const EdgeInsets.all(24),
                                  child: Column(
                                    mainAxisAlignment: MainAxisAlignment.center,
                                    children: [
                                      const Icon(
                                        Icons.videocam_off_outlined,
                                        color: Colors.amber,
                                        size: 48,
                                      ),
                                      const SizedBox(height: 12),
                                      Text(
                                        'Raspberry Pi camera stream unreachable at $piStreamHost',
                                        textAlign: TextAlign.center,
                                        style: const TextStyle(
                                          color: Colors.white,
                                          fontSize: 15,
                                          fontWeight: FontWeight.w600,
                                        ),
                                      ),
                                      const SizedBox(height: 8),
                                      const Text(
                                        'Ensure pi_camera_service.py is running on your Raspberry Pi,\nor switch to your laptop webcam backup below.',
                                        textAlign: TextAlign.center,
                                        style: TextStyle(color: Colors.white70, fontSize: 12),
                                      ),
                                      const SizedBox(height: 16),
                                      ElevatedButton.icon(
                                        style: ElevatedButton.styleFrom(
                                          backgroundColor: const Color(0xFF0F766E),
                                          foregroundColor: Colors.white,
                                          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
                                        ),
                                        onPressed: () {
                                          setDialogState(() {
                                            activeSource = 'webcam';
                                            selectedCameraSource[patientId] = 'webcam';
                                          });
                                          setState(() {});
                                        },
                                        icon: const Icon(Icons.swap_horiz),
                                        label: const Text('Switch to Laptop Webcam Backup'),
                                      ),
                                    ],
                                  ),
                                );
                              },
                            ),
                          ),
                        ),
                        const SizedBox(height: 10),
                        // Collapsible Pi Host config
                        Row(
                          children: [
                            Text(
                              'Stream URL: $currentStreamUrl',
                              style: const TextStyle(fontSize: 12, color: Colors.black54),
                            ),
                            const Spacer(),
                            TextButton.icon(
                              onPressed: () {
                                setDialogState(() {
                                  showSettings = !showSettings;
                                });
                              },
                              icon: const Icon(Icons.settings, size: 16),
                              label: Text(showSettings ? 'Hide Address' : 'Change Pi Address', style: const TextStyle(fontSize: 12)),
                            ),
                          ],
                        ),
                        if (showSettings)
                          Padding(
                            padding: const EdgeInsets.only(top: 6, bottom: 10),
                            child: Row(
                              children: [
                                Expanded(
                                  child: TextField(
                                    controller: hostController,
                                    decoration: const InputDecoration(
                                      labelText: 'Raspberry Pi Host / IP:Port',
                                      hintText: 'e.g. raspberrypi.local:8080 or 192.168.1.15:8080',
                                      isDense: true,
                                      border: OutlineInputBorder(),
                                    ),
                                  ),
                                ),
                                const SizedBox(width: 8),
                                ElevatedButton(
                                  onPressed: () {
                                    setDialogState(() {
                                      piStreamHost = hostController.text.trim();
                                      showSettings = false;
                                    });
                                    setState(() {});
                                  },
                                  child: const Text('Save'),
                                ),
                              ],
                            ),
                          ),
                      ] else ...[
                        // Laptop Webcam Section
                        Container(
                          width: double.infinity,
                          padding: const EdgeInsets.all(24),
                          decoration: BoxDecoration(
                            color: Colors.teal.shade50.withValues(alpha: 0.6),
                            borderRadius: BorderRadius.circular(10),
                            border: Border.all(color: Colors.teal.shade200),
                          ),
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.center,
                            children: [
                              const Icon(Icons.laptop_chromebook, size: 48, color: Color(0xFF0F766E)),
                              const SizedBox(height: 12),
                              const Text(
                                'Laptop Webcam Active (Authorized Nurse Monitoring)',
                                style: TextStyle(
                                  fontSize: 16,
                                  fontWeight: FontWeight.bold,
                                  color: Color(0xFF0F766E),
                                ),
                              ),
                              const SizedBox(height: 8),
                              Text(
                                'Your laptop browser camera captures and submits 5-second IV fluid predictions for Patient $patientId ($patientName).\nYour nurse session authenticates automatically — no device key required!',
                                textAlign: TextAlign.center,
                                style: const TextStyle(fontSize: 13, color: Colors.black87),
                              ),
                              const SizedBox(height: 16),
                              Wrap(
                                spacing: 12,
                                runSpacing: 8,
                                alignment: WrapAlignment.center,
                                children: [
                                  ElevatedButton.icon(
                                    style: ElevatedButton.styleFrom(
                                      backgroundColor: const Color(0xFF0F766E),
                                      foregroundColor: Colors.white,
                                      padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 12),
                                    ),
                                    onPressed: () {
                                      final url = '${AuthService.baseUrl}/web/camera_patient_trial.html?patientId=${Uri.encodeComponent(patientId)}&token=${Uri.encodeComponent(widget.token)}';
                                      html.window.open(url, '_blank');
                                    },
                                    icon: const Icon(Icons.open_in_new),
                                    label: const Text('Open Webcam Monitoring Console'),
                                  ),
                                  OutlinedButton.icon(
                                    onPressed: () {
                                      setDialogState(() {
                                        activeSource = 'pi';
                                        selectedCameraSource[patientId] = 'pi';
                                      });
                                      setState(() {});
                                    },
                                    icon: const Icon(Icons.arrow_back),
                                    label: const Text('Switch back to Pi Camera'),
                                  ),
                                ],
                              ),
                            ],
                          ),
                        ),
                      ],

                      const Divider(height: 32),

                      // Corresponding IV Fluid-Level Predictions Section
                      Container(
                        padding: const EdgeInsets.all(16),
                        decoration: BoxDecoration(
                          color: isEmpty ? Colors.red.withValues(alpha: 0.08) : Colors.grey.shade100,
                          borderRadius: BorderRadius.circular(10),
                          border: Border.all(
                            color: isEmpty ? Colors.red.shade300 : Colors.grey.shade300,
                          ),
                        ),
                        child: Row(
                          children: [
                            CircleAvatar(
                              radius: 24,
                              backgroundColor: isEmpty
                                  ? Colors.red.withValues(alpha: 0.15)
                                  : const Color(0xFF0F766E).withValues(alpha: 0.15),
                              child: Icon(
                                isEmpty ? Icons.warning_amber : Icons.water_drop,
                                color: isEmpty ? Colors.red : const Color(0xFF0F766E),
                                size: 26,
                              ),
                            ),
                            const SizedBox(width: 14),
                            Expanded(
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(
                                    'Current Fluid Level: ${level ?? 'Awaiting readings...'}',
                                    style: TextStyle(
                                      fontSize: 16,
                                      fontWeight: FontWeight.bold,
                                      color: isEmpty ? Colors.red : Colors.black87,
                                    ),
                                  ),
                                  const SizedBox(height: 4),
                                  Text(
                                    confidence != null
                                        ? 'Model Confidence: ${(double.parse(confidence.toString()) * 100).toStringAsFixed(1)}% | Device: ${deviceStatus.toUpperCase()}'
                                        : 'Status: ${deviceStatus.toUpperCase()} (Captures every 5 seconds)',
                                    style: const TextStyle(fontSize: 12, color: Colors.black54),
                                  ),
                                ],
                              ),
                            ),
                            buildDeviceStatus(deviceStatus),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            );
          },
        );
      },
    );
  }

  Widget buildDeviceStatus(String status) {
    final online = status == 'online';

    return Container(
      padding: const EdgeInsets.symmetric(
        horizontal: 12,
        vertical: 7,
      ),
      decoration: BoxDecoration(
        color: online
            ? Colors.green.withValues(alpha: 0.12)
            : Colors.red.withValues(alpha: 0.12),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(
            Icons.circle,
            size: 9,
            color: online ? Colors.green : Colors.red,
          ),
          const SizedBox(width: 7),
          Text(
            online ? 'Device Online' : 'Device Offline',
            style: TextStyle(
              color: online ? Colors.green : Colors.red,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }

  Widget buildUrgentAlertBanner() {
    final newAlerts = alerts.where((a) => a['status'] == 'new').toList();
    if (newAlerts.isEmpty) return const SizedBox.shrink();

    return Column(
      children: newAlerts.map((alert) {
        final alertId = int.tryParse(alert['id'].toString()) ?? 0;
        final patientName = alert['patient_name'] ?? 'Patient';
        final bedNumber = alert['bed_number'] ?? '-';
        final patientId = alert['patient_id'] ?? '';
        final alertTime = alert['created_at'] != null
            ? DateTime.tryParse(alert['created_at'])?.toLocal().toString().substring(11, 19) ?? alert['created_at']
            : 'Just now';

        return Container(
          width: double.infinity,
          margin: const EdgeInsets.only(bottom: 16),
          padding: const EdgeInsets.all(18),
          decoration: BoxDecoration(
            color: const Color(0xFFFEF2F2),
            borderRadius: BorderRadius.circular(12),
            border: Border.all(color: const Color(0xFFEF4444), width: 1.5),
            boxShadow: [
              BoxShadow(
                color: Colors.red.withValues(alpha: 0.1),
                blurRadius: 8,
                offset: const Offset(0, 3),
              ),
            ],
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  const Icon(Icons.warning_rounded, color: Color(0xFFDC2626), size: 28),
                  const SizedBox(width: 10),
                  const Expanded(
                    child: Text(
                      'URGENT CLINICAL ALERT — IV FLUID CONTAINER EMPTY',
                      style: TextStyle(
                        fontSize: 16,
                        fontWeight: FontWeight.bold,
                        color: Color(0xFFDC2626),
                      ),
                    ),
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 4),
                    decoration: BoxDecoration(
                      color: const Color(0xFFDC2626),
                      borderRadius: BorderRadius.circular(12),
                    ),
                    child: const Text(
                      'ACTION REQUIRED',
                      style: TextStyle(
                        color: Colors.white,
                        fontSize: 11,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              Text(
                'Patient: $patientName (ID: $patientId) | Bed Number: $bedNumber | Detected: $alertTime',
                style: const TextStyle(
                  fontSize: 14,
                  fontWeight: FontWeight.w600,
                  color: Color(0xFF7F1D1D),
                ),
              ),
              const SizedBox(height: 6),
              const Text(
                'The IV saline level has reached 0%. Please inspect the infusion line and replace the saline bottle immediately.',
                style: TextStyle(fontSize: 13, color: Color(0xFF991B1B)),
              ),
              const SizedBox(height: 14),
              Row(
                children: [
                  ElevatedButton.icon(
                    style: ElevatedButton.styleFrom(
                      backgroundColor: const Color(0xFFDC2626),
                      foregroundColor: Colors.white,
                      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
                    ),
                    onPressed: () => acknowledgeAlert(alertId),
                    icon: const Icon(Icons.check_circle_outline, size: 18),
                    label: const Text('Acknowledge Alert'),
                  ),
                  const SizedBox(width: 10),
                  OutlinedButton.icon(
                    style: OutlinedButton.styleFrom(
                      foregroundColor: const Color(0xFF7F1D1D),
                      side: const BorderSide(color: Color(0xFFDC2626)),
                    ),
                    onPressed: () => showLiveCamera(patientName, patientId),
                    icon: const Icon(Icons.videocam, size: 18),
                    label: const Text('Check Camera Feed'),
                  ),
                ],
              ),
            ],
          ),
        );
      }).toList(),
    );
  }

  Widget buildAlertsHistorySection() {
    return Container(
      margin: const EdgeInsets.only(top: 24, bottom: 20),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(Icons.notifications_active_outlined, color: Color(0xFF0F766E)),
              const SizedBox(width: 8),
              const Text(
                'IV Empty Alerts & Notifications',
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const Spacer(),
              TextButton.icon(
                onPressed: loadAlerts,
                icon: const Icon(Icons.refresh, size: 18),
                label: const Text('Refresh Alerts'),
              ),
            ],
          ),
          const SizedBox(height: 12),
          if (alerts.isEmpty)
            Card(
              elevation: 1,
              child: Padding(
                padding: const EdgeInsets.all(20),
                child: Row(
                  children: [
                    const Icon(Icons.check_circle_outline, color: Colors.green, size: 28),
                    const SizedBox(width: 12),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text(
                            'All IV containers operating normally',
                            style: TextStyle(fontWeight: FontWeight.bold, fontSize: 15),
                          ),
                          Text(
                            'No active or pending empty-fluid alerts for your assigned patients.',
                            style: TextStyle(color: Colors.grey.shade600, fontSize: 13),
                          ),
                        ],
                      ),
                    ),
                  ],
                ),
              ),
            )
          else
            ...alerts.map((alert) {
              final alertId = int.tryParse(alert['id'].toString()) ?? 0;
              final status = alert['status']?.toString() ?? 'new';
              final patientName = alert['patient_name'] ?? 'Patient';
              final bedNumber = alert['bed_number'] ?? '-';
              final patientId = alert['patient_id'] ?? '';
              final emailStatus = alert['email_status']?.toString() ?? 'not configured';
              final smsStatus = alert['sms_status']?.toString() ?? 'not configured';
              final alertTime = alert['created_at'] != null
                  ? DateTime.tryParse(alert['created_at'])?.toLocal().toString().substring(0, 19) ?? alert['created_at']
                  : '-';

              Color statusBg;
              Color statusColor;
              String statusLabel;

              if (status == 'new') {
                statusBg = Colors.red.shade50;
                statusColor = Colors.red.shade700;
                statusLabel = 'NEW';
              } else if (status == 'acknowledged') {
                statusBg = Colors.amber.shade50;
                statusColor = Colors.amber.shade800;
                statusLabel = 'ACKNOWLEDGED';
              } else {
                statusBg = Colors.green.shade50;
                statusColor = Colors.green.shade700;
                statusLabel = 'RESOLVED';
              }

              return Card(
                margin: const EdgeInsets.only(bottom: 12),
                child: Padding(
                  padding: const EdgeInsets.all(16),
                  child: Row(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Container(
                        padding: const EdgeInsets.all(10),
                        decoration: BoxDecoration(
                          color: statusBg,
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Icon(
                          status == 'resolved' ? Icons.check_circle : Icons.warning_amber,
                          color: statusColor,
                          size: 26,
                        ),
                      ),
                      const SizedBox(width: 14),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Row(
                              children: [
                                Text(
                                  '$patientName (Bed $bedNumber)',
                                  style: const TextStyle(
                                    fontSize: 16,
                                    fontWeight: FontWeight.bold,
                                  ),
                                ),
                                const SizedBox(width: 8),
                                Container(
                                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 2),
                                  decoration: BoxDecoration(
                                    color: statusBg,
                                    borderRadius: BorderRadius.circular(10),
                                  ),
                                  child: Text(
                                    statusLabel,
                                    style: TextStyle(
                                      color: statusColor,
                                      fontWeight: FontWeight.bold,
                                      fontSize: 11,
                                    ),
                                  ),
                                ),
                              ],
                            ),
                            const SizedBox(height: 4),
                            Text(
                              'Patient ID: $patientId | Detected: $alertTime',
                              style: const TextStyle(color: Colors.black54, fontSize: 12),
                            ),
                            const SizedBox(height: 4),
                            Text(
                              'Notifications: Email ($emailStatus) | SMS ($smsStatus)',
                              style: TextStyle(color: Colors.grey.shade600, fontSize: 11),
                            ),
                          ],
                        ),
                      ),
                      const SizedBox(width: 10),
                      Column(
                        crossAxisAlignment: CrossAxisAlignment.end,
                        children: [
                          if (status == 'new')
                            ElevatedButton(
                              style: ElevatedButton.styleFrom(
                                backgroundColor: const Color(0xFF0F766E),
                                foregroundColor: Colors.white,
                                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                              ),
                              onPressed: () => acknowledgeAlert(alertId),
                              child: const Text('Acknowledge'),
                            ),
                          if (status == 'acknowledged')
                            ElevatedButton(
                              style: ElevatedButton.styleFrom(
                                backgroundColor: Colors.green.shade700,
                                foregroundColor: Colors.white,
                                padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                              ),
                              onPressed: () => resolveAlert(alertId),
                              child: const Text('Resolve'),
                            ),
                          if (status == 'resolved')
                            const Padding(
                              padding: EdgeInsets.symmetric(vertical: 8),
                              child: Row(
                                children: [
                                  Icon(Icons.done_all, color: Colors.green, size: 16),
                                  SizedBox(width: 4),
                                  Text('Completed', style: TextStyle(color: Colors.green, fontSize: 12)),
                                ],
                              ),
                            ),
                        ],
                      ),
                    ],
                  ),
                ),
              );
            }),
        ],
      ),
    );
  }

  Widget buildPatientCard(dynamic patient) {
    final patientId = patient['patient_id'].toString();
    final monitoring = monitoringData[patientId];

    final latestReading = monitoring?['latest_reading'];
    final deviceStatus =
        monitoring?['device_status']?.toString() ?? 'offline';

    final level = latestReading?['level_label']?.toString();
    final confidence = latestReading?['confidence'];

    final isEmpty = level == 'Empty';
    final activeSource = selectedCameraSource[patientId] ?? 'pi';

    return Card(
      margin: const EdgeInsets.only(bottom: 18),
      elevation: 2,
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const CircleAvatar(
                  radius: 24,
                  child: Icon(Icons.person),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        patient['name'].toString(),
                        style: const TextStyle(
                          fontSize: 19,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        'Patient ID: $patientId',
                        style: const TextStyle(color: Colors.black54),
                      ),
                    ],
                  ),
                ),
                buildDeviceStatus(deviceStatus),
              ],
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                Text('Bed Number: ${patient['bed_number']}'),
                const Spacer(),
                Container(
                  padding: const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
                  decoration: BoxDecoration(
                    color: Colors.grey.shade200,
                    borderRadius: BorderRadius.circular(6),
                  ),
                  child: Row(
                    children: [
                      Icon(
                        activeSource == 'pi' ? Icons.camera : Icons.laptop_chromebook,
                        size: 13,
                        color: Colors.black87,
                      ),
                      const SizedBox(width: 4),
                      Text(
                        activeSource == 'pi' ? 'Primary: Pi Camera' : 'Backup: Webcam',
                        style: const TextStyle(fontSize: 11, fontWeight: FontWeight.w600),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            const Divider(height: 28),
            const Row(
              children: [
                Icon(Icons.monitor_heart_outlined),
                SizedBox(width: 8),
                Text(
                  'IV Fluid Monitoring',
                  style: TextStyle(
                    fontSize: 17,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
            const SizedBox(height: 16),

            if (latestReading == null)
              const Center(
                child: Padding(
                  padding: EdgeInsets.all(16),
                  child: Column(
                    children: [
                      Icon(
                        Icons.hourglass_empty,
                        size: 35,
                        color: Colors.grey,
                      ),
                      SizedBox(height: 8),
                      Text('No readings received yet'),
                    ],
                  ),
                ),
              )
            else ...[
              Container(
                width: double.infinity,
                padding: const EdgeInsets.all(18),
                decoration: BoxDecoration(
                  color: isEmpty
                      ? Colors.red.withValues(alpha: 0.08)
                      : Colors.teal.withValues(alpha: 0.07),
                  borderRadius: BorderRadius.circular(12),
                ),
                child: Column(
                  children: [
                    Text(
                      'Latest IV Fluid Level',
                      style: TextStyle(
                        color: Colors.grey.shade700,
                        fontSize: 14,
                      ),
                    ),
                    const SizedBox(height: 8),
                    Text(
                      level ?? 'Unknown',
                      style: TextStyle(
                        fontSize: 34,
                        fontWeight: FontWeight.bold,
                        color: isEmpty ? Colors.red : const Color(0xFF0F766E),
                      ),
                    ),
                    if (confidence != null) ...[
                      const SizedBox(height: 6),
                      Text(
                        'Confidence: ${(double.parse(confidence.toString()) * 100).toStringAsFixed(1)}%',
                        style: const TextStyle(
                          color: Colors.black54,
                        ),
                      ),
                    ],
                  ],
                ),
              ),
              const SizedBox(height: 12),
              if (isEmpty)
                const Row(
                  children: [
                    Icon(Icons.warning_amber, color: Colors.red),
                    SizedBox(width: 8),
                    Expanded(
                      child: Text(
                        'Empty level detected in recent readings. Alert protocol active.',
                        style: TextStyle(
                          color: Colors.red,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ),
                  ],
                ),
              if (deviceStatus == 'offline')
                const Padding(
                  padding: EdgeInsets.only(top: 8),
                  child: Row(
                    children: [
                      Icon(Icons.wifi_off, color: Colors.orange),
                      SizedBox(width: 8),
                      Expanded(
                        child: Text(
                          'No recent device reading. The displayed level may be outdated.',
                          style: TextStyle(color: Colors.orange),
                        ),
                      ),
                    ],
                  ),
                ),
            ],

            const SizedBox(height: 16),
            Row(
              children: [
                Expanded(
                  child: OutlinedButton.icon(
                    onPressed: () => showLiveCamera(
                      patient['name'].toString(),
                      patientId,
                    ),
                    icon: Icon(
                      activeSource == 'pi' ? Icons.videocam : Icons.laptop_chromebook,
                    ),
                    label: Text(
                      'Live Camera (${activeSource == 'pi' ? 'Pi' : 'Webcam'})',
                    ),
                  ),
                ),
                const SizedBox(width: 8),
                IconButton(
                  tooltip: 'Simulate / Test Empty Alert for this patient',
                  onPressed: () => triggerTestAlert(patientId),
                  icon: const Icon(Icons.add_alert_outlined, color: Colors.amber),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Nurse Dashboard'),
        actions: [
          IconButton(
            onPressed: loadDashboardData,
            icon: const Icon(Icons.refresh),
            tooltip: 'Refresh dashboard & alerts',
          ),
          TextButton.icon(
            onPressed: () {
              Navigator.pushAndRemoveUntil(
                context,
                MaterialPageRoute(
                  builder: (_) => const LoginPage(),
                ),
                (route) => false,
              );
            },
            icon: const Icon(Icons.logout),
            label: const Text('Logout'),
          ),
          const SizedBox(width: 12),
        ],
      ),
      body: Center(
        child: ConstrainedBox(
          constraints: const BoxConstraints(maxWidth: 1000),
          child: ListView(
            padding: const EdgeInsets.all(24),
            children: [
              // Urgent Alert Banner (shown prominently if any unacknowledged alerts exist)
              buildUrgentAlertBanner(),

              Text(
                'Welcome, ${widget.user['name']}!',
                style: const TextStyle(
                  fontSize: 26,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 8),
              Text(
                widget.user['email'].toString(),
                style: const TextStyle(color: Colors.black54),
              ),
              const SizedBox(height: 24),

              const Text(
                'My Patients',
                style: TextStyle(
                  fontSize: 22,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 16),

              if (loading)
                const Center(
                  child: Padding(
                    padding: EdgeInsets.all(30),
                    child: CircularProgressIndicator(),
                  ),
                ),

              if (errorMessage != null)
                Card(
                  child: Padding(
                    padding: const EdgeInsets.all(20),
                    child: Text(
                      errorMessage!,
                      style: const TextStyle(color: Colors.red),
                    ),
                  ),
                ),

              if (!loading && errorMessage == null && patients.isEmpty)
                const Card(
                  child: Padding(
                    padding: EdgeInsets.all(24),
                    child: Column(
                      children: [
                        Icon(
                          Icons.people_outline,
                          size: 45,
                          color: Colors.grey,
                        ),
                        SizedBox(height: 12),
                        Text(
                          'No patients assigned to you yet.',
                          style: TextStyle(fontSize: 16),
                        ),
                      ],
                    ),
                  ),
                ),

              if (!loading && errorMessage == null)
                ...patients.map(buildPatientCard),

              // Alerts History Section
              buildAlertsHistorySection(),

              const Divider(height: 36),
              const Padding(
                padding: EdgeInsets.only(bottom: 24),
                child: Text(
                  'Notice: This IV fluid monitoring system is an auxiliary clinical aid based on computer vision. '
                  'Automated alerts are designed to support timely nursing attention and do not replace direct regular observation by trained clinical staff.',
                  textAlign: TextAlign.center,
                  style: TextStyle(color: Colors.black45, fontSize: 12, height: 1.5),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
